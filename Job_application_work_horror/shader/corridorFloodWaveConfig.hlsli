#ifndef SIGNAL_LOST_CORRIDOR_FLOOD_WAVE_CONFIG_HLSLI
#define SIGNAL_LOST_CORRIDOR_FLOOD_WAVE_CONFIG_HLSLI

#include "renderingConfig.hlsli"

// 床の描画を終えてから波を描くため、同じスロットを順に使う。
#define SIGNAL_LOST_FLOOD_WAVE_BUFFER_SLOT SIGNAL_LOST_WET_FLOOR_BUFFER_SLOT
#define SIGNAL_LOST_FLOOD_WAVE_BACKGROUND_SLOT 0
#define SIGNAL_LOST_FLOOD_WAVE_SRV_IMPL(slot) t ## slot
#define SIGNAL_LOST_FLOOD_WAVE_SRV(slot) SIGNAL_LOST_FLOOD_WAVE_SRV_IMPL(slot)
// 右側の通路の中心から、南北の廊下の東の壁（x=45）で曲がり始め、半径40で南へ向きを変える円弧。物理座標はC++でも使う。
// 半径を通路の半分の幅（18）より十分大きくし、内側の岸がその場で回るように見えないようにしている。
#define SIGNAL_LOST_FLOOD_SOURCE_X 111.0f
#define SIGNAL_LOST_FLOOD_BEND_START_X 45.0f
#define SIGNAL_LOST_FLOOD_BEND_RADIUS 40.0f
#define SIGNAL_LOST_FLOOD_BEND_CENTER_Z 255.0f
#define SIGNAL_LOST_FLOOD_QUARTER_TURN 1.5707963268f
#define SIGNAL_LOST_FLOOD_WAVE_DEPTH 54.0f
#define SIGNAL_LOST_FLOOD_WAVE_COLUMNS 56
#define SIGNAL_LOST_FLOOD_WAVE_ROWS 48
#define SIGNAL_LOST_FLOOD_WAVE_VERTICES_PER_CELL 6
// 波頭から飛ぶしぶきの粒の数と、1粒の頂点の数（四角形1枚 = 三角形2つ）
#define SIGNAL_LOST_FLOOD_SPRAY_COUNT 520
#define SIGNAL_LOST_FLOOD_SPRAY_VERTICES_PER_PARTICLE 6

#endif
