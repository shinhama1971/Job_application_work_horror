// ============================================================================
// ファイルの役割: 照明の影響を受けないテクスチャ色を出力します。
// 主な技術: HLSL Pixel Shader、テクスチャサンプリング、アルファ
// 読み方: この実装ファイルでは宣言された機能の具体的な処理を定義します。
// ============================================================================

// ============================================================================
// シェーダーの役割: 照明の影響を受けないテクスチャ色を出力します。
// 定数バッファのスロットと入出力構造はCPU側の定義と必ず一致させてください。
// ============================================================================

#include "common.hlsl"

Texture2D g_Texture : register(t0);
SamplerState g_SamplerState : register(s0);

// ピクセルシェーダーのエントリーポイントです。
float4 main(in PS_IN input) : SV_Target
{
    float4 color;
	
    // Sampleで指定UV位置のテクスチャ色を読み取ります。
    color = g_Texture.Sample(g_SamplerState, input.tex);
    color *= input.col;

   // color = input.col;

    return color;
}
