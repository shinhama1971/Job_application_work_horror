// ============================================================================
// ファイルの役割: HUDテクスチャの色と透明度を最終画素へ出力します。
// 主な技術: HLSL Pixel Shader、テクスチャサンプリング、アルファ合成
// 読み方: この実装ファイルでは宣言された機能の具体的な処理を定義します。
// ============================================================================

// ============================================================================
// シェーダーの役割: HUDスプライトの色とアルファを出力します。
// ============================================================================

struct PSInput
{
    float4 position : SV_POSITION;
    float4 color : COLOR;
};

float4 main(PSInput input) : SV_TARGET
{
    return input.color;
}
