// ============================================================================
// シェーダーの役割: HUDの四角形の色と透明度を、そのまま出力している。
// ============================================================================

// 頂点シェーダー（hudVS）から受け取る値：画面の位置と色
struct PSInput
{
    float4 position : SV_POSITION;
    float4 color : COLOR;
};

// 頂点の色をそのまま画素の色にしている
float4 main(PSInput input) : SV_TARGET
{
    return input.color;
}
