#ifndef COMPUTE_DISPATCH_CONFIG_INCLUDED
#define COMPUTE_DISPATCH_CONFIG_INCLUDED

// C++ が確保する画像の大きさと Dispatch のグループ数を、GPU が扱う縮小率と numthreads に合わせる。
#define SIGNAL_LOST_OCCLUSION_DOWNSAMPLE_FACTOR 2
#define SIGNAL_LOST_OCCLUSION_GROUP_SIZE 8
#define SIGNAL_LOST_BLOOM_WIDE_DOWNSAMPLE_FACTOR 2
#define SIGNAL_LOST_BLOOM_TILE_GROUP_SIZE 8
#define SIGNAL_LOST_BLOOM_BLUR_GROUP_SIZE 128
