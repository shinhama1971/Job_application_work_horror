#define SIGNAL_LOST_DDGI_RAY_RESULTS_SLOT 1
#define SIGNAL_LOST_DDGI_IRRADIANCE_ATLAS_SLOT 2
#define SIGNAL_LOST_DDGI_DISTANCE_ATLAS_SLOT 3
#define SIGNAL_LOST_DDGI_PREVIOUS_ATLAS_SLOT 4
#define SIGNAL_LOST_DDGI_SCENE_DEPTH_SLOT 5
#define SIGNAL_LOST_DDGI_OUTPUT_SLOT 0
#define SIGNAL_LOST_GRASS_SIM_PARAMS_SLOT 0
#define SIGNAL_LOST_GRASS_SIM_INPUT_SLOT 0
#define SIGNAL_LOST_GRASS_SIM_OUTPUT_SLOT 0
#define SIGNAL_LOST_SHAFT_PARAMS_SLOT 0
#define SIGNAL_LOST_SHAFT_DEPTH_SLOT 0
#define SIGNAL_LOST_SHAFT_POINT_LIGHTS_SLOT 1
#define SIGNAL_LOST_SHAFT_OUTPUT_SLOT 0
