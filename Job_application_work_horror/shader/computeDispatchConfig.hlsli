#define SIGNAL_LOST_RIPPLE_PARAMS_SLOT 0
#define SIGNAL_LOST_RIPPLE_PREVIOUS_STATE_SLOT 0
#define SIGNAL_LOST_RIPPLE_NEXT_STATE_SLOT 0
#define SIGNAL_LOST_BLOOM_COMPUTE_INPUT_SLOT 0
#define SIGNAL_LOST_BLOOM_COMPUTE_OUTPUT_SLOT 0
#define SIGNAL_LOST_AUTO_EXPOSURE_PARAMS_SLOT 0
