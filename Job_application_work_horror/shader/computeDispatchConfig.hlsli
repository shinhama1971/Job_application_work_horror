#define SIGNAL_LOST_DDGI_APPLY_DOWNSAMPLE_FACTOR 2
#define SIGNAL_LOST_DDGI_APPLY_GROUP_SIZE 8
#define SIGNAL_LOST_GRASS_GROUP_SIZE 256

// 波紋の2つの上限は、C++ と HLSL の定数バッファの配列幅にも使う。
#define SIGNAL_LOST_RIPPLE_GROUP_SIZE 16
#define SIGNAL_LOST_RIPPLE_MAX_IMPULSES 16
#define SIGNAL_LOST_RIPPLE_MAX_OBSTACLES 32

// C++ と Compute Shader で揃えるバインド先と自動露出の状態の添字。
#define SIGNAL_LOST_AO_PARAMS_SLOT 0
#define SIGNAL_LOST_AO_DEPTH_SLOT 0
